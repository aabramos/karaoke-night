<?xml version="1.0" encoding="utf-8"?>
<!-- Buttons squish a little when pressed. (No growing on focus: a bigger button gets cut off by
     whatever it sits in, near an edge. The focus colour and outline show where the remote is.) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="70" android:propertyName="scaleX" android:valueTo="0.95" android:valueType="floatType" />
            <objectAnimator android:duration="70" android:propertyName="scaleY" android:valueTo="0.95" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="120" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
