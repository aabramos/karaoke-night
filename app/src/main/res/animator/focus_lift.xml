<?xml version="1.0" encoding="utf-8"?>
<!-- Buttons grow a little when the remote lands on them and squish when pressed (scale only: no shadows) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="70" android:propertyName="scaleX" android:valueTo="0.94" android:valueType="floatType" />
            <objectAnimator android:duration="70" android:propertyName="scaleY" android:valueTo="0.94" android:valueType="floatType" />
        </set>
    </item>
    <item android:state_focused="true">
        <set>
            <objectAnimator android:duration="140" android:interpolator="@android:interpolator/decelerate_quad" android:propertyName="scaleX" android:valueTo="1.06" android:valueType="floatType" />
            <objectAnimator android:duration="140" android:interpolator="@android:interpolator/decelerate_quad" android:propertyName="scaleY" android:valueTo="1.06" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="140" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="140" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
