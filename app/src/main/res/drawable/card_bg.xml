<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="160">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#3A2466" />
            <stroke android:width="3dp" android:color="@color/neon_pink" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#B31F143A" />
            <stroke android:width="3dp" android:color="#00000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
