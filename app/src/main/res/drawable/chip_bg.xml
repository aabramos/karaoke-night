<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="160">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/neon_pink" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#4A2A7A" />
            <stroke android:width="2dp" android:color="@color/neon_cyan" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#CC2A1B4A" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
