<?xml version="1.0" encoding="utf-8"?>
<!-- 🎭 Themed party: a theme, who sings, how many songs; the app fills the queue in fair turns.
     Theme ideas and singer buttons are made in the code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true">

    <LinearLayout
        android:layout_width="760dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="18dp"
        android:paddingEnd="28dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="🎭 THEMED PARTY"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Pick a theme and who sings: the queue fills up by itself, everyone in turn."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <!-- 1. Theme: typed, spoken, or one of the ideas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/PickerSection"
                android:text="THEME" />

            <EditText
                android:id="@+id/themeInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/field_bg"
                android:hint="Disney, 80s, Queen, love songs…"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="40"
                android:maxLines="1"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/text_main"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/themeVoice"
                style="@style/IconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="Say a theme"
                android:text="🎙" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="96dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/themeIdeas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 2. Who sings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/PickerSection"
                android:text="SINGERS" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/themeSingers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="96dp">

            <EditText
                android:id="@+id/themeNewSinger"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/field_bg"
                android:hint="＋ New singer: type a name, then Done"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="20"
                android:maxLines="1"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/text_main"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 3. How many songs, and go -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/PickerSection"
                android:text="SONGS" />

            <TextView
                android:id="@+id/themeLess"
                style="@style/TvButton"
                android:layout_width="48dp"
                android:layout_height="46dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:contentDescription="Fewer songs"
                android:text="−" />

            <TextView
                android:id="@+id/themeCount"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/gold"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/themeMore"
                style="@style/TvButton"
                android:layout_width="48dp"
                android:layout_height="46dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:contentDescription="More songs"
                android:text="+" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/themeCancel"
                style="@style/TvButton"
                android:layout_height="48dp"
                android:text="Cancel" />

            <TextView
                android:id="@+id/themeGo"
                style="@style/TvButton.Primary"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:text="🎭 Fill the queue" />
        </LinearLayout>

        <TextView
            android:id="@+id/themeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:minHeight="20dp"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
