<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim_strong"
    android:clickable="true">

    <LinearLayout
        android:layout_width="900dp"
        android:layout_height="match_parent"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="14dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:shadowColor="@color/gold"
            android:shadowRadius="20"
            android:text="🏆 HALL OF FAME"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />

        <!-- Solo tonight / all time, duets tonight / all time, achievements, back -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabTonight"
                style="@style/TvButton"
                android:layout_height="46dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:contentDescription="Solo, tonight"
                android:text="🎤 Tonight"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tabAll"
                style="@style/TvButton"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:contentDescription="Solo, all time"
                android:text="🎤 All time"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tabDuetsTonight"
                style="@style/TvButton"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:contentDescription="Duets, tonight"
                android:text="👫 Tonight"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tabDuetsAll"
                style="@style/TvButton"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:contentDescription="Duets, all time"
                android:text="👫 All time"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tabAch"
                style="@style/TvButton"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="🏅 Achievements"
                android:textSize="15sp" />

            <!-- Back to the party (BACK on the remote does the same) -->
            <TextView
                android:id="@+id/boardClose"
                style="@style/TvButton.Primary"
                android:layout_height="46dp"
                android:layout_marginStart="18dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="← Back"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/boardHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <!-- A ranking: the podium, then the full list. ▼ moves down the list (it scrolls), ▲ back to the tabs. -->
        <ScrollView
            android:id="@+id/boardScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <!-- Podium: 2nd, 1st, 3rd -->
                <LinearLayout
                    android:id="@+id/podium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/boardRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/boardEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="No scores yet. Grab a mic! 🎤"
            android:textColor="@color/text_dim"
            android:textSize="20sp"
            android:visibility="gone" />

        <!-- Achievements tab: every singer and what they've unlocked; OK opens their full list -->
        <ScrollView
            android:id="@+id/boardAchScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/boardAchRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
