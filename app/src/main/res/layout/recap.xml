<?xml version="1.0" encoding="utf-8"?>
<!-- "Close the night": tonight's awards, one by one, then the podium and a summary.
     OK / tap = next, BACK = leave. Everything inside is filled in from the code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:clickable="true">

    <com.karaoketv.StageView
        android:id="@+id/recapStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Turning rays of light behind each winner -->
    <com.karaoketv.RaysView
        android:id="@+id/recapRays"
        android:layout_width="620dp"
        android:layout_height="620dp"
        android:layout_gravity="center"
        android:alpha="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- One award (or the opening title) -->
        <LinearLayout
            android:id="@+id/recapCard"
            android:layout_width="760dp"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/recapKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.3"
                android:textColor="@color/neon_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recapIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:textSize="70sp" />

            <TextView
                android:id="@+id/recapTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:shadowColor="@color/neon_pink"
                android:shadowRadius="26"
                android:textColor="#FFFFFF"
                android:textSize="34sp" />

            <LinearLayout
                android:id="@+id/recapWinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/recapAvatar"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/bg_deep"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recapName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxWidth="620dp"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowDy="3"
                    android:shadowRadius="18"
                    android:textColor="@color/gold"
                    android:textSize="50sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/recapDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/pill_bg"
                android:gravity="center"
                android:maxWidth="700dp"
                android:paddingStart="22dp"
                android:paddingTop="8dp"
                android:paddingEnd="22dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text_main"
                android:textSize="19sp" />
        </LinearLayout>

        <!-- Tonight's top 3, built from the code -->
        <LinearLayout
            android:id="@+id/recapPodium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The end: every award at a glance -->
    <LinearLayout
        android:id="@+id/recapEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:shadowColor="@color/neon_pink"
            android:shadowRadius="26"
            android:text="🌙 THAT'S A WRAP!"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/recapEndSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/recapEndGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/recapDone"
                style="@style/TvButton.Primary"
                android:text="Back to the party" />

            <TextView
                android:id="@+id/recapAgain"
                style="@style/TvButton"
                android:layout_marginStart="12dp"
                android:text="↻ Watch again" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/recapHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />
</FrameLayout>
