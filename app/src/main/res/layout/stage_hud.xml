<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/nowPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="22dp">

        <TextView
            android:id="@+id/nowAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="#0B0614"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nowSinger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_main"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/nowSong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="420dp"
                android:maxLines="1"
                android:textColor="@color/text_dim"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nextPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="18dp"
        android:paddingEnd="8dp">

        <TextView
            style="@style/Label"
            android:text="UP NEXT" />

        <TextView
            android:id="@+id/nextSinger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nextAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:textColor="#0B0614"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/stageHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/pill_bg"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="◀ ▶ music volume    OK pause    ▼ queue    ↩ menu"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <!-- Phones: shown when the video is tapped -->
    <LinearLayout
        android:id="@+id/touchBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/pill_bg"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tbPause"
            android:contentDescription="Pause or resume"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chip_bg"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="⏯"
            android:textColor="@color/text_main"
            android:textSize="18sp" />
        <!-- Drag to set the music volume (the singers' microphones aren't affected) -->
        <LinearLayout
            android:id="@+id/tbVolumeBox"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chip_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="🎵"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/tbVolume"
                android:contentDescription="Music volume"
                android:layout_width="220dp"
                android:layout_height="40dp"
                android:max="100"
                android:progressDrawable="@drawable/volume_track"
                android:thumbTint="@color/neon_pink" />
        </LinearLayout>
        <TextView
            android:id="@+id/tbQueue"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chip_bg"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="📋 Queue"
            android:textColor="@color/text_main"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/tbMenu"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chip_bg"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="☰ Menu"
            android:textColor="@color/text_main"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/volumeHud"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="70dp"
        android:alpha="0"
        android:background="@drawable/pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎵"
            android:textSize="20sp" />

        <ProgressBar
            android:id="@+id/volumeBar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            android:max="100"
            android:progressDrawable="@drawable/volume_track" />

        <TextView
            android:id="@+id/volumeText"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
