<?xml version="1.0" encoding="utf-8"?>
<!-- Two volumes: songs + countdown/score sounds, and the lobby music on its own -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="🔊 VOLUME"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="The TV's own volume and the microphones are separate."
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <!-- Songs, countdown and score sounds -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎤 Songs &amp; sound effects"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/volumeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:shadowColor="@color/neon_pink"
                android:shadowRadius="14"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Focusable: the remote's ◀ ▶ move it; on phones it's dragged -->
        <SeekBar
            android:id="@+id/volumeSlider"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/chip_bg"
            android:contentDescription="Volume for songs and sound effects"
            android:focusable="true"
            android:max="100"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:progressDrawable="@drawable/volume_track"
            android:thumbTint="@color/neon_pink" />

        <!-- Lobby music, usually much lower: it plays while people talk -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎵 Lobby music"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lobbyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:shadowColor="@color/neon_cyan"
                android:shadowRadius="14"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/lobbySlider"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/chip_bg"
            android:contentDescription="Lobby music volume"
            android:focusable="true"
            android:max="100"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:progressDrawable="@drawable/volume_track"
            android:thumbTint="@color/neon_cyan" />

        <TextView
            android:id="@+id/volumeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="◀ ▶ to change"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/volumeMusic"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/volumeDone"
                style="@style/TvButton.Primary"
                android:layout_marginStart="12dp"
                android:text="Done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
