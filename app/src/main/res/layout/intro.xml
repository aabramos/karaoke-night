<?xml version="1.0" encoding="utf-8"?>
<!-- Opening animation, shown once when the app starts. Transparent: the stage lights behind it
     (the animated background) shine through. Any key or tap skips it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:contentDescription="Karaoke Night">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/introMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="@color/neon_pink"
            android:shadowRadius="40"
            android:text="🎤"
            android:textSize="96sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/introKaraoke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:shadowColor="@color/neon_pink"
                android:shadowRadius="30"
                android:text="KARAOKE"
                android:textColor="#FFFFFF"
                android:textSize="60sp" />

            <TextView
                android:id="@+id/introNight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:shadowColor="@color/neon_cyan"
                android:shadowRadius="30"
                android:text="NIGHT"
                android:textColor="@color/neon_cyan"
                android:textSize="60sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/introTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.2"
            android:text="GRAB A MIC · THE PARTY STARTS NOW"
            android:textColor="@color/gold"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
