<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Emoji reactions floating up the left side, behind everything else -->
    <com.karaoketv.ReactionsView
        android:id="@+id/scReactions"
        android:importantForAccessibility="no"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The score in the middle, the judges' panel on the right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="440dp"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/scAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:textColor="#0B0614"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scSinger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:textColor="@color/neon_cyan"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/scSong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxWidth="500dp"
            android:maxLines="1"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/scScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:shadowColor="@color/neon_pink"
            android:shadowRadius="40"
            android:text="--"
            android:textColor="@color/gold"
            android:textSize="132sp" />

        <TextView
            android:id="@+id/scStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:textColor="@color/gold"
            android:textSize="38sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/scVerdict"
            android:accessibilityLiveRegion="polite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:shadowColor="@color/neon_pink"
            android:shadowRadius="24"
            android:maxLines="1"
            android:textColor="@color/text_main"
            android:textSize="36sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/scRank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/neon_cyan"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <!-- Achievements: debut, personal best, hat-trick… (gone when there are none) -->
        <TextView
            android:id="@+id/scBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/pill_bg"
            android:gravity="center"
            android:maxWidth="500dp"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:textColor="@color/gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/scNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/pill_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- The judges hold up their paddles one by one -->
    <LinearLayout
        android:id="@+id/scJudges"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:orientation="vertical">

        <TextView
            style="@style/Label"
            android:layout_gravity="center_horizontal"
            android:text="THE JUDGES" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
