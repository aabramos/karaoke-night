<?xml version="1.0" encoding="utf-8"?>
<!-- One screen, many layers. Only one or two are visible at a time. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.karaoketv.StageView
        android:id="@+id/stageBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The YouTube player is added here only while the party is on (frees memory in the lobby) -->
    <FrameLayout
        android:id="@+id/stageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:descendantFocusability="blocksDescendants"
        android:visibility="invisible" />

    <!-- Phones: catches taps on the video (the video itself ignores touches) -->
    <View
        android:id="@+id/stageTouch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Covers the video while paused and in the last seconds, where YouTube shows suggestions -->
    <FrameLayout
        android:id="@+id/stageCurtain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F70B0614"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/curtainTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:maxWidth="760dp"
                android:shadowColor="@color/neon_pink"
                android:shadowRadius="26"
                android:textColor="#FFFFFF"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/curtainSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/text_dim"
                android:textSize="20sp" />
        </LinearLayout>
    </FrameLayout>

    <include
        android:id="@+id/lobby"
        layout="@layout/lobby" />

    <include
        android:id="@+id/hud"
        layout="@layout/stage_hud"
        android:visibility="gone" />

    <include
        android:id="@+id/queuePanel"
        layout="@layout/queue_panel"
        android:visibility="gone" />

    <include
        android:id="@+id/intermission"
        layout="@layout/intermission"
        android:visibility="gone" />

    <include
        android:id="@+id/scoreLayer"
        layout="@layout/score"
        android:visibility="gone" />

    <include
        android:id="@+id/boardLayer"
        layout="@layout/leaderboard"
        android:visibility="gone" />

    <include
        android:id="@+id/pickerLayer"
        layout="@layout/picker"
        android:visibility="gone" />

    <include
        android:id="@+id/sheetLayer"
        layout="@layout/sheet"
        android:visibility="gone" />

    <include
        android:id="@+id/qrLayer"
        layout="@layout/qr_big"
        android:visibility="gone" />

    <include
        android:id="@+id/countryLayer"
        layout="@layout/country"
        android:visibility="gone" />

    <include
        android:id="@+id/volumeLayer"
        layout="@layout/volume"
        android:visibility="gone" />

    <include
        android:id="@+id/aboutLayer"
        layout="@layout/about"
        android:visibility="gone" />

    <include
        android:id="@+id/achLayer"
        layout="@layout/achievements"
        android:visibility="gone" />

    <include
        android:id="@+id/introLayer"
        layout="@layout/intro"
        android:visibility="gone" />

    <TextView
        android:id="@+id/toast"
        android:accessibilityLiveRegion="polite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="22dp"
        android:background="@drawable/pill_bg"
        android:elevation="8dp"
        android:maxWidth="640dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_main"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.karaoketv.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
