<?xml version="1.0" encoding="utf-8"?>
<!-- One singer's achievements: unlocked ones in colour with the date, the rest show how to get them -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim_strong"
    android:clickable="true">

    <LinearLayout
        android:layout_width="800dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/panel_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/achAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="#0B0614"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/achTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:maxWidth="600dp"
                android:shadowColor="@color/gold"
                android:shadowRadius="18"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/achSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <!-- Personal stats as a row of tiles: best score, favourite song, songs, parties, in a row (built in code) -->
        <LinearLayout
            android:id="@+id/achStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <!-- Everything scrolls: ▲▼ on the remote (the focus stays on Back), or a swipe -->
        <ScrollView
            android:id="@+id/achScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbarThumbVertical="@color/text_dim"
            android:scrollbarSize="3dp"
            android:fadeScrollbars="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/achGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Label"
                    android:layout_gravity="start"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="4dp"
                    android:text="🎼 GENRES SUNG" />

                <LinearLayout
                    android:id="@+id/achGenres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/achClose"
            style="@style/TvButton.Primary"
            android:layout_marginTop="10dp"
            android:text="← Back" />
    </LinearLayout>
</FrameLayout>
