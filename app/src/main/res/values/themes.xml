<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KaraokeTV" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:colorAccent">@color/neon_pink</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="TvButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:minWidth">130dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:stateListAnimator">@animator/focus_lift</item>
    </style>

    <style name="TvButton.Primary">
        <item name="android:background">@drawable/btn_primary</item>
    </style>

    <!-- Small section heading in the "Who's singing?" pop-up -->
    <style name="PickerSection">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">20sp</item>
        <item name="android:stateListAnimator">@animator/focus_lift</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.25</item>
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
